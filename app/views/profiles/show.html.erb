<div class="max-w-md mx-auto bg-white p-4 rounded-lg shadow-md">
  <h1 class="text-2xl font-bold">マイページ</h1>

  <div class="mt-4">
    <label class="block text-sm font-medium text-gray-700">名前</label>
    <p class="mt-1 text-gray-900"><%= @user.name %></p>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700">メールアドレス</label>
    <p class="mt-1 text-gray-900"><%= @user.email %></p>
  </div>

  <div class="mt-4 border-t pt-4">
    <h2 class="text-lg font-semibold text-gray-900">LINEリマインド</h2>
    <p class="mt-1 text-sm text-gray-600">設定時刻: <%= @user.reminder_time_label %>（<%= @user.time_zone %>）</p>
    <p class="mt-1 text-sm text-gray-600">
      通知: <%= @user.reminder_enabled? ? 'ON' : 'OFF' %>
    </p>
    <p class="mt-1 text-sm text-gray-600">
      LINE連携:
      <% if @user.line_linked? %>
        <span class="text-green-700 font-medium">連携済み</span>
      <% else %>
        <span class="text-amber-700 font-medium">未連携</span>
      <% end %>
    </p>

    <% if @user.link_token_valid? %>
      <div class="mt-3 p-3 bg-indigo-50 rounded-md">
        <p class="text-sm text-gray-700">連携コード（24時間有効）:</p>
        <p class="mt-1 text-xl font-mono font-bold text-indigo-700"><%= @user.line_link_token %></p>
        <p class="mt-2 text-xs text-gray-600">LINE公式アカウントにこのコードを送ってください。</p>
      </div>
    <% end %>

    <% unless @user.line_linked? %>
      <%= button_to 'LINE連携コードを発行', line_link_token_profile_path, method: :post,
          class: 'mt-3 inline-block bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded transition duration-200' %>
    <% end %>
  </div>

  <div class="mt-6 flex items-center space-x-4">
    <%= link_to '編集する', edit_profile_path, class: 'inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded transition duration-200' %>
    <%= link_to '日記一覧へ', diaries_path, class: 'text-sm text-indigo-600 hover:text-indigo-700 font-medium' %>
  </div>
</div>
