<div class="max-w-md mx-auto bg-white p-4 rounded-lg shadow-md">
  <h1 class="text-2xl font-bold">プロフィール編集</h1>

  <%= form_with model: @user, url: profile_path, method: :patch, local: true, class: "space-y-4" do |f| %>
    <% if @user.errors.any? %>
      <div class="bg-red-50 text-red-500 p-4 rounded-md">
        <ul class="list-disc pl-5">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, 'お名前', class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :email, 'メールアドレス', class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :password, '新しいパスワード', class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-indigo-500", placeholder: "変更する場合のみ入力" %>
    </div>

    <div>
      <%= f.label :password_confirmation, '新しいパスワード（確認）', class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password_confirmation, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-indigo-500", placeholder: "変更する場合のみ入力" %>
    </div>

    <div class="border-t pt-4">
      <h2 class="text-lg font-semibold text-gray-900">LINEリマインド設定</h2>
      <p class="mt-1 text-sm text-gray-600">毎日の学習習慣をサポートする通知をLINEで受け取れます。</p>

      <div class="mt-3">
        <%= f.label :reminder_enabled, class: "flex items-center gap-2 text-sm text-gray-700" do %>
          <%= f.check_box :reminder_enabled, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
          リマインド通知を有効にする
        <% end %>
      </div>

      <div class="mt-3 grid grid-cols-2 gap-3">
        <div>
          <%= f.label :reminder_hour, '時（0-23）', class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :reminder_hour, (0..23).map { |h| [format('%02d', h), h] }, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= f.label :reminder_minute, '分（0-59）', class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :reminder_minute, (0..59).map { |m| [format('%02d', m), m] }, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
        </div>
      </div>

      <div class="mt-3">
        <%= f.label :time_zone, 'タイムゾーン', class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :time_zone, User::TIME_ZONE_OPTIONS, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
      </div>
    </div>

    <div class="pt-4 flex flex-col sm:flex-row gap-3 sm:gap-4">
      <%= link_to 'キャンセル', profile_path, class: "w-full sm:w-1/2 text-center bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold py-2 px-4 rounded transition duration-200" %>
      <%= f.submit '更新する', class: "w-full sm:w-1/2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded transition duration-200 cursor-pointer" %>
    </div>
  <% end %>
</div>
