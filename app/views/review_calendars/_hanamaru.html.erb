<% compact = local_assigns.fetch(:compact, false) %>
<% stamp_size = compact ? 'h-7 w-7' : 'h-8 w-8' %>
<span class="relative inline-flex <%= stamp_size %> items-center justify-center" aria-label="日記を書いた日" title="日記を書いた日">
  <svg class="absolute inset-0 h-full w-full text-red-500" viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="1.5">
      <circle cx="16" cy="6.2" r="3.6" />
      <circle cx="23.4" cy="9.2" r="3.6" />
      <circle cx="25.8" cy="16.8" r="3.6" />
      <circle cx="20.4" cy="24.2" r="3.6" />
      <circle cx="11.6" cy="24.2" r="3.6" />
      <circle cx="6.2" cy="16.8" r="3.6" />
      <circle cx="8.6" cy="9.2" r="3.6" />
      <circle cx="16" cy="16" r="6.2" />
    </g>
  </svg>
  <span class="relative z-10 <%= compact ? 'text-[11px]' : 'text-sm' %> font-semibold text-red-600"><%= day %></span>
</span>
