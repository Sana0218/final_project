<%= tag.button(
      type: 'button',
      class: 'block w-full text-left',
      data: {
        action: 'diary-modal#open',
        diary_modal_payload_value: {
          date: l(diary.created_at, format: :long),
          content: diary.content,
          corrected_text: diary.corrected_text,
          feedback: diary.feedback
        }.to_json
      }
    ) do %>
  <% compact = local_assigns.fetch(:compact, false) %>
  <article class="<%= compact ? 'bg-white p-3 rounded-md hover:shadow-sm' : 'bg-white p-6 rounded-lg shadow-md hover:shadow-lg' %> transition cursor-pointer">
    <time class="<%= compact ? 'text-xs' : 'text-sm' %> text-gray-500" datetime="<%= diary.created_at.iso8601 %>">
      <%= l(diary.created_at, format: :long) %>
    </time>
    <p class="mt-2 text-gray-800 <%= compact ? 'text-sm line-clamp-2' : 'mt-3 line-clamp-3' %> whitespace-pre-wrap"><%= truncate(diary.content, length: compact ? 80 : 120) %></p>
    <% unless compact %>
      <p class="mt-3 text-sm text-indigo-600 font-medium">詳細を見る</p>
    <% end %>
  </article>
<% end %>
