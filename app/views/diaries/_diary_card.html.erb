<%= tag.button(
      type: 'button',
      class: 'block w-full text-left',
      data: {
        action: 'diary-modal#open',
        diary_modal_payload_value: {
          date: l(diary.created_at, format: :long),
          content: diary.content
        }.to_json
      }
    ) do %>
  <article class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition cursor-pointer">
    <time class="text-sm text-gray-500" datetime="<%= diary.created_at.iso8601 %>">
      <%= l(diary.created_at, format: :long) %>
    </time>
    <p class="mt-3 text-gray-800 line-clamp-3 whitespace-pre-wrap"><%= truncate(diary.content, length: 120) %></p>
    <p class="mt-3 text-sm text-indigo-600 font-medium">詳細を見る</p>
  </article>
<% end %>
