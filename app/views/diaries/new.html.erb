<div class="max-w-3xl mx-auto bg-white p-6 rounded-lg shadow-md">
  <h1 class="text-2xl font-bold mb-2">日記を書く</h1>
  <p class="text-sm text-gray-500 mb-6">英語で書ける部分は英語で、わからない部分は日本語で書いてみましょう。</p>

  <%= form_with model: @diary, local: true do |f| %>
    <% if @diary.errors.any? %>
      <div class="mb-4 p-4 bg-red-100 text-red-700 rounded-md">
        <ul class="list-disc pl-5">
          <% @diary.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-6">
      <%= f.label :content, '日記の内容', class: 'block text-sm font-medium text-gray-700 mb-1' %>
      <%= f.text_area :content, rows: 12, placeholder: 'Today I went to the park. 天気がよくて気持ちよかった。', class: 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-indigo-500' %>
    </div>

    <div class="flex items-center justify-between space-x-4">
      <%= link_to 'キャンセル', diaries_path, class: 'w-1/2 text-center bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold py-2 px-4 rounded transition duration-200' %>
      <%= f.submit '投稿する', class: 'w-1/2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded transition duration-200 cursor-pointer' %>
    </div>
  <% end %>
</div>
