<div class="h-full min-h-0 grid grid-cols-1 lg:grid-cols-3 gap-6">
  <section class="min-h-0 flex flex-col gap-4">
    <div class="shrink-0 flex flex-col gap-3">
      <%= link_to new_diary_path,
          class: 'flex items-center justify-center gap-2 bg-green-100 hover:bg-green-200 text-green-800 font-semibold py-3 px-4 rounded-lg transition shadow-sm' do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13L2.25 21.75l.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
        </svg>
        日記を書く
      <% end %>
      <%= link_to reviews_path,
          class: 'flex items-center justify-center gap-2 bg-indigo-100 hover:bg-indigo-200 text-indigo-800 font-semibold py-3 px-4 rounded-lg transition shadow-sm' do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
        本日の復習
      <% end %>
    </div>

    <div class="lg:flex-1 min-h-0 bg-white rounded-lg shadow-sm border border-gray-200 p-3 flex flex-col overflow-visible">
      <div class="flex items-center justify-between gap-2 mb-3 shrink-0">
        <%= link_to review_calendar_path, class: 'text-sm font-bold text-gray-900 hover:text-indigo-600' do %>
          <%= @calendar.month.year %>年<%= @calendar.month.month %>月
        <% end %>
        <div class="flex gap-1">
          <%= link_to '前',
              root_path(month: @calendar.month.prev_month.strftime('%Y-%m')),
              class: 'text-xs px-2 py-1 rounded border border-gray-300 text-gray-700 hover:bg-gray-50' %>
          <%= link_to '今月',
              root_path,
              class: 'text-xs px-2 py-1 rounded border border-gray-300 text-gray-700 hover:bg-gray-50' %>
          <%= link_to '翌',
              root_path(month: @calendar.month.next_month.strftime('%Y-%m')),
              class: 'text-xs px-2 py-1 rounded border border-gray-300 text-gray-700 hover:bg-gray-50' %>
        </div>
      </div>
      <div class="min-h-0 max-h-96 overflow-auto lg:max-h-none lg:overflow-visible">
        <%= render 'review_calendars/grid', calendar: @calendar, compact: true %>
      </div>
    </div>
  </section>

  <section class="min-h-0 flex flex-col bg-red-50 rounded-lg p-4 lg:overflow-hidden">
    <div class="flex items-center justify-between gap-2 mb-3 shrink-0">
      <h2 class="text-sm font-bold text-gray-900">作成した日記</h2>
      <%= link_to '一覧へ', diaries_path, class: 'text-xs text-indigo-600 hover:text-indigo-700 font-medium' %>
    </div>
    <div class="space-y-2 lg:flex-1 lg:min-h-0 lg:overflow-hidden">
      <% if @recent_diaries.any? %>
        <%= render partial: 'diaries/diary_card', collection: @recent_diaries, as: :diary, locals: { compact: true } %>
      <% else %>
        <p class="text-sm text-gray-500 py-6 text-center">まだ日記がありません。</p>
      <% end %>
    </div>
  </section>

  <section class="min-h-0 flex flex-col bg-red-50 rounded-lg p-4 lg:overflow-hidden">
    <div class="flex items-center justify-between gap-2 mb-3 shrink-0">
      <h2 class="text-sm font-bold text-gray-900">保存したフレーズ</h2>
      <%= link_to '一覧へ', phrases_path, class: 'text-xs text-indigo-600 hover:text-indigo-700 font-medium' %>
    </div>
    <div class="space-y-2 lg:flex-1 lg:min-h-0 lg:overflow-hidden">
      <% if @recent_user_phrases.any? %>
        <ul class="space-y-2">
          <% @recent_user_phrases.each do |user_phrase| %>
            <li class="bg-white rounded-md p-3">
              <p class="text-sm text-gray-900 font-medium line-clamp-2"><%= user_phrase.phrase.content %></p>
              <p class="mt-1 text-xs text-gray-500">次回: <%= l(user_phrase.next_review_date, format: :long) %></p>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-gray-500 py-6 text-center">保存済みのフレーズはまだありません。</p>
      <% end %>
    </div>
  </section>
</div>
