<div class="max-w-2xl mx-auto">
  <div class="flex items-start justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">保存済みフレーズ</h1>
      <p class="text-sm text-gray-500 mt-1">これまでに保存したフレーズの一覧です。</p>
    </div>
    <%= link_to '日記を書く', new_diary_path, class: 'text-sm text-indigo-600 hover:text-indigo-700 font-medium' %>
  </div>

  <% if @user_phrases.any? %>
    <ul class="space-y-4">
      <% @user_phrases.each do |user_phrase| %>
        <li class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
          <p class="text-lg text-gray-900 font-medium"><%= user_phrase.phrase.content %></p>
          <dl class="mt-3 grid grid-cols-1 sm:grid-cols-3 gap-2 text-sm text-gray-500">
            <div>
              <dt class="font-medium text-gray-600">保存日</dt>
              <dd><%= l(user_phrase.created_at, format: :long) %></dd>
            </div>
            <div>
              <dt class="font-medium text-gray-600">復習ステージ</dt>
              <dd><%= user_phrase.review_stage %></dd>
            </div>
            <div>
              <dt class="font-medium text-gray-600">次回復習予定</dt>
              <dd><%= l(user_phrase.next_review_date, format: :long) %></dd>
            </div>
          </dl>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="bg-white text-center py-10 border border-dashed border-gray-300 rounded-lg shadow-sm">
      <p class="text-gray-600 mb-4">保存済みのフレーズはまだありません。</p>
      <p class="text-sm text-gray-500 mb-6">日記を投稿し、添削後にフレーズを保存するとここに表示されます。</p>
      <%= link_to '日記を書く',
          new_diary_path,
          class: 'inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-6 rounded transition duration-200' %>
    </div>
  <% end %>
</div>
