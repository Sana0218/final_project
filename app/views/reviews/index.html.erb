<div class="max-w-2xl mx-auto bg-white p-4 sm:p-6 rounded-lg shadow-md">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">本日の復習</h1>
      <p class="text-sm text-gray-500 mt-1">復習予定のフレーズを確認し、正解・不正解を記録してください。</p>
    </div>
    <%= link_to '日記を書く', new_diary_path, class: 'text-sm text-indigo-600 hover:text-indigo-700 font-medium shrink-0' %>
  </div>

  <% if @user_phrases.any? %>
    <ul class="space-y-4">
      <% @user_phrases.each do |user_phrase| %>
        <li class="border border-gray-200 rounded-lg p-4">
          <p class="text-lg text-gray-900 font-medium mb-3 break-words"><%= user_phrase.phrase.content %></p>
          <p class="text-xs text-gray-500 mb-4">
            復習ステージ: <%= user_phrase.review_stage %> / 次回予定: <%= l(user_phrase.next_review_date, format: :long) %>
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <%= button_to '正解',
                complete_review_path(user_phrase),
                method: :post,
                params: { correct: true },
                data: { turbo_submits_with: '記録中...' },
                class: 'flex-1 bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded transition duration-200 cursor-pointer' %>
            <%= button_to '不正解',
                complete_review_path(user_phrase),
                method: :post,
                params: { correct: false },
                data: { turbo_submits_with: '記録中...' },
                class: 'flex-1 bg-orange-500 hover:bg-orange-600 text-white font-bold py-2 px-4 rounded transition duration-200 cursor-pointer' %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="text-center py-10 border border-dashed border-gray-300 rounded-lg">
      <p class="text-gray-600 mb-4">本日復習すべきフレーズはありません。</p>
      <%= link_to '日記を書く',
          new_diary_path,
          class: 'inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-6 rounded transition duration-200' %>
    </div>
  <% end %>
</div>
